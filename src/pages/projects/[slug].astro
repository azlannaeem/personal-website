---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const hasLinks = project.data.repoUrl || project.data.demoUrl;
---

<BaseLayout title={project.data.title} description={project.data.description}>
	<a href="/projects" class="link-underline text-sm text-neutral-400 hover:text-neutral-100">← Back to projects</a>

	<div class="mt-4 flex items-center gap-2">
		<h1 class="text-2xl font-bold tracking-tight text-neutral-100">{project.data.title}</h1>
		{project.data.status === "in-progress" && (
			<span class="rounded-full border border-amber-400/40 bg-amber-400/10 px-2.5 py-0.5 text-xs font-medium uppercase tracking-wide text-amber-300">In Progress</span>
		)}
	</div>
	<ul class="mt-3 flex flex-wrap gap-1.5">
		{project.data.stack.map((tech: string) => (
			<li class="rounded-full bg-accent/10 px-2.5 py-0.5 text-xs text-accent transition-transform duration-200 hover:scale-110">{tech}</li>
		))}
	</ul>

	<div class="mt-4 flex gap-4 text-sm">
		{project.data.repoUrl && (
			<a href={project.data.repoUrl} class="link-underline text-neutral-400 hover:text-neutral-100">Source code</a>
		)}
		{project.data.demoUrl && (
			<a href={project.data.demoUrl} class="link-underline text-neutral-400 hover:text-neutral-100">Live demo</a>
		)}
		{!hasLinks && project.data.status === "in-progress" && (
			<span class="text-neutral-500">Repo and demo links coming once available.</span>
		)}
	</div>

	<article class="mt-8 space-y-4 text-neutral-300 [&_h2]:mt-6 [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:text-neutral-100 [&_ul]:list-disc [&_ul]:pl-5">
		<Content />
	</article>
</BaseLayout>
