---
import type { FavoriteCategory } from "../data/favorites";

interface Props {
	items: string[];
	categories: FavoriteCategory[];
}

const { items, categories } = Astro.props;
---

<div>
	<p class="mx-auto max-w-lg text-white/60">
		Outside of code, I'm big on sports — watching and playing. Football (Arsenal, through thick and thin),
		basketball, and F1, plus cycling, hiking, reading, watching films, and traveling whenever I get the chance.
	</p>

	<div class="mt-8 flex flex-wrap justify-center gap-3">
		{items.map((item) => (
			<span class={`glass rounded-full px-4 py-2 text-sm ${item === "Arsenal FC" ? "text-accent" : "text-white/80"}`}>{item}</span>
		))}
	</div>

	<div class="mt-10 flex flex-wrap justify-center gap-2">
		{categories.map((c, i) => (
			<button
				data-tab={c.id}
				class:list={["fav-tab rounded-full border px-4 py-2 text-sm transition", i === 0 ? "active border-accent/60 text-accent" : "border-white/15 text-white/70 hover:border-white/40"]}
			>
				{c.label}
			</button>
		))}
	</div>

	<div class="mt-6 min-h-[12rem]">
		{categories.map((c, i) => (
			<div data-panel={c.id} class:list={["fav-panel glass mx-auto max-w-2xl rounded-2xl p-6 text-left", i === 0 ? "" : "hidden"]}>
				{c.blurb && <p class="text-sm leading-relaxed text-white/70">{c.blurb}</p>}

				{c.names && c.names.length > 0 && (
					c.blurb ? (
						<div class="mt-3 flex flex-wrap gap-1.5">
							{c.names.map((name) => (
								<span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-xs text-accent">{name}</span>
							))}
						</div>
					) : (
						<ul class="space-y-1">
							{c.names.map((name) => (
								<li class="font-display text-base font-medium text-neutral-100">{name}</li>
							))}
						</ul>
					)
				)}

				{c.lists && c.lists.length > 0 && (
					<div class="mt-3 space-y-3">
						{c.lists.map((list) => (
							<div>
								<p class="text-[10px] uppercase tracking-widest text-white/40">{list.heading}</p>
								<p class="mt-1 text-sm text-neutral-200">{list.items.join(", ")}</p>
							</div>
						))}
					</div>
				)}

				{c.outro && <p class="mt-3 text-sm leading-relaxed text-white/70">{c.outro}</p>}

				{c.link && c.link.url && (
					<a href={c.link.url} class="link-underline mt-3 inline-block text-sm text-accent">{c.link.label} →</a>
				)}
				{c.link && !c.link.url && (
					<p class="mt-3 text-xs text-white/30">({c.link.label})</p>
				)}

				{c.photos && c.photos.length > 0 ? (
					<div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
						{c.photos.map((src) => (
							<img src={src} alt="" class="aspect-square w-full rounded-lg object-cover" />
						))}
					</div>
				) : c.id === "travel" ? (
					<div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
						{Array.from({ length: 6 }).map(() => (
							<div class="flex aspect-square items-center justify-center rounded-lg border border-dashed border-white/15 bg-white/[0.02] text-xs text-white/30">
								photo
							</div>
						))}
					</div>
				) : null}
			</div>
		))}
	</div>
</div>

<script>
	const tabs = document.querySelectorAll<HTMLElement>("[data-tab]");
	const panels = document.querySelectorAll<HTMLElement>("[data-panel]");

	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			tabs.forEach((t) => t.classList.remove("active", "border-accent/60", "text-accent"));
			tabs.forEach((t) => t.classList.add("border-white/15", "text-white/70"));
			tab.classList.add("active", "border-accent/60", "text-accent");
			tab.classList.remove("border-white/15", "text-white/70");

			panels.forEach((p) => p.classList.toggle("hidden", p.dataset.panel !== tab.dataset.tab));
		});
	});
</script>
