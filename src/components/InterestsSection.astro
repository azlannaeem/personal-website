---
interface Props {
	items: string[];
}

const { items } = Astro.props;
---

<div>
	<p class="mx-auto max-w-lg text-white/60">
		Outside of code, I'm big on sports — watching and playing. Football (Arsenal, through thick and thin),
		basketball, and F1, plus cycling, hiking, reading, and traveling whenever I get the chance.
	</p>
	<div class="mt-8 flex flex-wrap justify-center gap-3">
		{items.map((item) => (
			<span class={`glass rounded-full px-4 py-2 text-sm ${item === "Arsenal FC" ? "text-accent" : "text-white/80"}`}>{item}</span>
		))}
	</div>
	<p class="mt-6 text-xs text-white/30">(2 more coming)</p>
</div>
