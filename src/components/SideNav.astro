---
interface Props {
	sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<nav class="fixed right-6 top-1/2 z-40 hidden -translate-y-1/2 flex-col items-center gap-5 sm:flex">
	{sections.map((s) => (
		<a data-target={s.id} class="navdot h-2.5 w-2.5 rounded-full bg-white/30" title={s.label}></a>
	))}
</nav>
