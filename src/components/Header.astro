---
import { profile } from "../data/resume";
---

<header class="border-b border-white/10">
	<nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
		<a href="/" class="font-semibold tracking-tight">{profile.name}</a>
		<div class="flex gap-6 text-sm text-neutral-400">
			<a href="/projects" class="link-underline hover:text-neutral-100">Projects</a>
			<a href="/resume" class="link-underline hover:text-neutral-100">Resume</a>
			<a href={profile.links.github} class="link-underline hover:text-neutral-100">GitHub</a>
		</div>
	</nav>
</header>
