---
import type { ExperienceEntry } from "../data/resume";

interface Props {
	items: ExperienceEntry[];
}

const { items } = Astro.props;
---

<div class="relative w-full max-w-3xl">
	<div class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-gradient-to-b from-transparent via-white/15 to-transparent"></div>

	{items.map((job, i) => {
		const left = i % 2 === 0;
		const card = (
			<div class="tl-card glass inline-block rounded-2xl p-5 text-left">
				<p class="text-xs text-white/40">{job.start} – {job.end}</p>
				<p class="font-display text-lg font-semibold text-neutral-100">{job.role}</p>
				<p class="text-sm text-accent">{job.organization}</p>
				<p class="mt-2 text-sm text-white/60">{job.bullets[0]}</p>
			</div>
		);
		return (
			<div class="tl-row relative grid grid-cols-[1fr_2rem_1fr] items-center pb-16 last:pb-0">
				<div class={left ? "col-start-1 pr-8 text-right" : "col-start-1"}>{left && card}</div>
				<div class="col-start-2 flex justify-center">
					<span class="tl-dot absolute left-1/2 top-6 h-4 w-4 -translate-x-1/2 rounded-full border-2 border-accent/70 bg-[#050507]"></span>
				</div>
				<div class={!left ? "col-start-3 pl-8 text-left" : "col-start-3"}>{!left && card}</div>
			</div>
		);
	})}
</div>
