---
interface Props {
	slug: string;
	title: string;
	description: string;
	stack: string[];
	status?: "completed" | "in-progress";
}

const { slug, title, description, stack, status = "completed" } = Astro.props;
---

<a
	href={`/projects/${slug}`}
	class="project-card block rounded-xl border border-white/10 bg-white/[0.03] p-5 hover:-translate-y-1 hover:border-accent/50"
>
	<div class="flex items-center gap-2">
		<h3 class="font-medium text-neutral-100">{title}</h3>
		{status === "in-progress" && (
			<span class="rounded-full border border-amber-400/40 bg-amber-400/10 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-amber-300">In Progress</span>
		)}
	</div>
	<p class="mt-1 text-sm text-neutral-400">{description}</p>
	<ul class="mt-3 flex flex-wrap gap-1.5">
		{stack.map((tech) => (
			<li class="rounded-full bg-accent/10 px-2.5 py-0.5 text-xs text-accent transition-transform duration-200 hover:scale-110">{tech}</li>
		))}
	</ul>
</a>
